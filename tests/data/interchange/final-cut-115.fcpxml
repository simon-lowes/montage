<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<!-- Written for Montage's tests after the FCPXML 1.15 DTD: a clip with natural motion
     blur, a semantic mask and the flags attribute; keys interpolated as 1.15 allows; a connected clip whose offset
     lies before its parent's start; 1.15's motion-blurred frame sampling. -->
<fcpxml version="1.15">
  <resources>
    <format id="r1" name="FFVideoFormat1080p25" frameDuration="1/25s" width="1920" height="1080"/>
    <asset id="r2" name="street" start="0s" duration="60s" hasVideo="1" hasAudio="0" format="r1">
      <media-rep kind="original-media" src="file:///nonexistent/street.mov"/>
    </asset>
    <asset id="r3" name="interview" start="0s" duration="60s" hasVideo="1" hasAudio="1" format="r1" audioSources="1" audioChannels="2" audioRate="48000">
      <media-rep kind="original-media" src="file:///nonexistent/interview.mov"/>
    </asset>
    <effect id="r4" name="Gaussian Blur" uid="FFGaussianBlur"/>
  </resources>
  <library>
    <event name="Tests">
      <project name="Blur">
        <sequence format="r1" duration="20s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
          <spine>
            <video ref="r2" offset="0s" name="Street" start="0s" duration="10s" flags="1">
              <adjust-natural-motion-blur amount="1.5"/>
              <filter-video-mask inverted="0">
                <mask-semantic name="Sky" type="sky" blendMode="add">
                  <param name="Feather" value="0.1"/>
                </mask-semantic>
                <filter-video ref="r4" name="Gaussian Blur">
                  <param name="Amount" key="1" value="20"/>
                </filter-video>
              </filter-video-mask>
            </video>
            <asset-clip ref="r3" offset="10s" name="Interview" start="5s" duration="6s" audioRole="dialogue.boom" flags="1">
              <adjust-transform>
                <param name="position">
                  <keyframeAnimation>
                    <keyframe time="5s" value="0 0" interp="hold"/>
                    <keyframe time="6s" value="10 5" interp="passthrough"/>
                    <keyframe time="7s" value="20 5" interp="bezier"/>
                    <keyframe time="8s" value="0 0"/>
                  </keyframeAnimation>
                </param>
              </adjust-transform>
              <asset-clip ref="r2" lane="1" offset="4s" name="Cutaway" start="20s" duration="3s" flags="1"/>
            </asset-clip>
            <video ref="r2" offset="16s" name="Slow" start="30s" duration="4s">
              <timeMap frameSampling="vsa-motion-blur" preservesPitch="0">
                <timept time="0s" value="0s" interp="linear"/>
                <timept time="4s" value="2s" interp="linear"/>
              </timeMap>
            </video>
          </spine>
        </sequence>
      </project>
    </event>
  </library>
</fcpxml>
