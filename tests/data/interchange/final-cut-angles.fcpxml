    <effect id="x1" name="Cross Dissolve" uid="FxPlug:4731E73A-8DAC-4113-9A30-AE85B1761265"/>
    <media id="m1" name="Three Cams">
      <multicam format="r1" tcStart="0s" tcFormat="NDF">
        <mc-angle name="Cam A" angleID="A">
          <sync-clip offset="0s" name="A sync" start="0s" duration="40s">
