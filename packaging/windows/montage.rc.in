// Windows resources for montage.exe: the icon Explorer shows and the version details.
#include <winver.h>

IDI_ICON1 ICON "@MONTAGE_PACKAGING_DIR@/windows/montage.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Montage"
      VALUE "FileDescription", "Montage video editor"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "montage"
      VALUE "OriginalFilename", "montage.exe"
      VALUE "ProductName", "Montage"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
